# APG 835/837 Rate Analyzer — backend image
# Build from the repo root:
#     docker build -t apg-analyzer-backend -f Dockerfile.backend .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install Python deps first for better layer caching
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install -r /app/backend/requirements.txt

# Copy source
COPY backend /app/backend

# Runtime-created dirs (volume mounts will back these in docker-compose)
RUN mkdir -p /app/backend/data /app/backend/uploads /app/backend/exports

EXPOSE 8000

# Reference data is NOT baked into the image (it's PHI-adjacent and versioned separately).
# Initialize it once by running:
#   docker compose run --rm backend python -m backend.db.init_db --workbook /app/workbooks/ref.xlsx
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
