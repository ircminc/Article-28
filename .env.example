# APG 835/837 Rate Analyzer — environment template
# Copy to .env and adjust for your environment.

# SQLite database location (async URL)
DATABASE_URL=sqlite+aiosqlite:///./data/apg_analyzer.db

# Path to the NYS DOH / APG reference Excel workbook used by init_db.py
# Only required when (re)initializing the reference data.
REFERENCE_WORKBOOK_PATH=

# Where uploaded 835/837 files are stored (PHI — keep local-only)
UPLOAD_DIR=./uploads

# Where generated Excel/PDF reports are written
EXPORT_DIR=./exports

# CMS API cache TTL in seconds (Phase 2)
CMS_API_CACHE_TTL=86400

# Logging level
LOG_LEVEL=INFO
